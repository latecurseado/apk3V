{
    "name": "Tres Valles — Portal Comunitario",
    "short_name": "Tres Valles",
    "description": "Portal comunitario de Tres Valles, Veracruz: foro, noticias locales, mapa interactivo de negocios y directorio.",
    "lang": "es-MX",
    "dir": "ltr",
    "start_url": "./index.html",
    "scope": "./",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
    "orientation": "portrait",
    "background_color": "#0a0a0c",
    "theme_color": "#00d2ff",
    "categories": ["social", "news", "lifestyle"],
    "id": "tres-valles-portal",
    "prefer_related_applications": false,
    "related_applications": [],
    "icons": [
        { "src": "main/icons/icon-48.png",   "sizes": "48x48",   "type": "image/png", "purpose": "any" },
        { "src": "main/icons/icon-72.png",   "sizes": "72x72",   "type": "image/png", "purpose": "any" },
        { "src": "main/icons/icon-96.png",   "sizes": "96x96",   "type": "image/png", "purpose": "any" },
        { "src": "main/icons/icon-144.png",  "sizes": "144x144", "type": "image/png", "purpose": "any" },
        { "src": "main/icons/icon-192.png",  "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
        { "src": "main/icons/icon-512.png",  "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
        { "src": "main/icons/icon-1024.png", "sizes": "1024x1024","type": "image/png", "purpose": "any" }
    ],
    "screenshots": [
        {
            "src": "main/icons/screenshot-mobile.png",
            "sizes": "1080x1920",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "Tres Valles en móvil — Foro y noticias locales"
        },
        {
            "src": "main/icons/screenshot-desktop.png",
            "sizes": "1920x1080",
            "type": "image/png",
            "form_factor": "wide",
            "label": "Tres Valles en escritorio — Foro, noticias y mapa interactivo"
        }
    ],
    "shortcuts": [
        {
            "name": "Foro",
            "short_name": "Foro",
            "description": "Ver discusiones recientes",
            "url": "./index.html#foro",
            "icons": [{ "src": "main/icons/icon-96.png", "sizes": "96x96" }]
        },
        {
            "name": "Noticias",
            "short_name": "Noticias",
            "description": "Últimas noticias locales",
            "url": "./index.html#noticias",
            "icons": [{ "src": "main/icons/icon-96.png", "sizes": "96x96" }]
        },
        {
            "name": "Crear publicación",
            "short_name": "Crear",
            "description": "Publicar un hilo nuevo",
            "url": "./index.html#crear",
            "icons": [{ "src": "main/icons/icon-96.png", "sizes": "96x96" }]
        }
    ],
    "share_target": {
        "action": "./",
        "method": "GET",
        "enctype": "application/x-www-form-urlencoded",
        "params": {
            "title": "share_title",
            "text": "share_text",
            "url": "share_url"
        }
    }
}
